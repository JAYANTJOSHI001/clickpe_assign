# AWS region for deployed Lambda functions, S3, and SES (e.g. ap-south-1, us-east-1)
AWS_REGION=ap-south-1

# Name of the S3 bucket used for direct CSV uploads and rejected records
UPLOAD_BUCKET=loan-eligibility-engine-uploads-unique-id

# Public hostname or endpoint of the RDS PostgreSQL instance
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com

# PostgreSQL port (default is 5432)
DB_PORT=5432

# Name of the PostgreSQL database
DB_NAME=postgres

# Master username for PostgreSQL authentication
DB_USER=postgres

# Master password for PostgreSQL authentication
DB_PASSWORD=your_secure_password_here

# Full public webhook URL called by process_csv Lambda (matches <tunnel-url>/webhook/loan-batch)
N8N_WEBHOOK_URL=https://your-tunnel-subdomain.trycloudflare.com/webhook/loan-batch

# Shared secret key passed in the X-Webhook-Secret header to verify webhook authenticity
N8N_WEBHOOK_SECRET=your_random_webhook_secret_here

# Verified sender email address in Amazon SES to send loan recommendation notifications
SES_SENDER_EMAIL=sender@example.com

# n8n encryption key to secure stored credentials in SQLite (generate with openssl rand -hex 16)
N8N_ENCRYPTION_KEY=your_random_32_character_encryption_key_here

# Public base URL of the n8n instance required for correct webhook listener resolution
WEBHOOK_URL=https://your-tunnel-subdomain.trycloudflare.com/

# Basic authentication username for securing the n8n web dashboard
N8N_BASIC_AUTH_USER=admin

# Basic authentication password for securing the n8n web dashboard
N8N_BASIC_AUTH_PASSWORD=your_secure_n8n_password_here
