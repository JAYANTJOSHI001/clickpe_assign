{
  "name": "C - Email Notification",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  m.id AS match_id,\n  m.user_id,\n  u.email,\n  m.product_id,\n  p.provider,\n  p.product_name,\n  p.interest_rate_min,\n  p.interest_rate_max,\n  m.match_stage,\n  m.score,\n  m.reason\nFROM matches m\nJOIN users u\n  ON u.user_id = m.user_id\nJOIN loan_products p\n  ON p.id = m.product_id\nWHERE m.batch_id = '{{ $json.batch_id }}'::uuid\n  AND m.match_stage = 'eligible'\n  AND m.notified = FALSE\nORDER BY m.id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        0
      ],
      "id": "a567c9de-a804-4b01-9b5f-b2346761a05e",
      "name": "Get Eligible Matches",
      "credentials": {
        "postgres": {
          "id": "3hOXM3qy9Eq3PYcJ",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const p = item.json;\n\n  const rate =\n    p.interest_rate_min !== null && p.interest_rate_max !== null\n      ? `${p.interest_rate_min}% - ${p.interest_rate_max}%`\n      : 'Not specified';\n\n  const subject = `Loan Match Found - ${p.product_name}`;\n\n  const body = `Hi,\n\nGood news! Based on your profile, you may be eligible for the following loan product:\n\nProvider: ${p.provider}\nLoan Product: ${p.product_name}\nInterest Rate: ${rate}\n\nYour eligibility checks:\n- Income: Passed\n- Credit Score: Passed\n- Age: Passed\n- Employment: Passed\n\nMatch Score: ${p.score}\n\nWhy you matched:\n${p.reason}\n\nPlease visit the lender's official website and verify the latest eligibility criteria, interest rates, and terms before applying.\n\nRegards,\nLoan Eligibility Engine`;\n\n  return {\n    json: {\n      ...p,\n      email_subject: subject,\n      email_body: body\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
